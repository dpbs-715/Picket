{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picket",
  "version": "0.2.2",
  "identifier": "dev.picket.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main", "title": "Picket", "width": 400, "height": 700,
      "minWidth": 400, "minHeight": 480, "resizable": true, "visible": false,
      "backgroundColor": "#0B0D10",
      "decorations": true, "titleBarStyle": "Overlay", "hiddenTitle": true,
      "trafficLightPosition": { "x": 12, "y": 21 },
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/picket-node"],
    "resources": { "resources/generated/": "sidecar/" },
    "macOS": { "minimumSystemVersion": "14.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQTlFNzA0MTkxRTA4RTQKUldUa0NCNFpCT2VwSVozbVR4TmVHNHJjWWJwSk01c1RZcE1YQ1dvcnZMd25Od3h2emFKVkhVYSsK",
      "endpoints": [
        "https://github.com/dpbs-715/Picket/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
