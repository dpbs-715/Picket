{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context", "agent",
        "--language-backend", "LSP",
        "--agent-interface", "tools",
        "--enable-web-dashboard", "false",
        "--enable-gui-log-window", "false"
      ],
      "cwd": ".",
      "env": {
        "PATH": "${HOME}/.cargo/bin:${HOME}/.local/bin:${PATH}"
      },
      "description": "Symbol lookup, reference navigation, and controlled code editing for Picket TypeScript/TSX/JavaScript and Rust. Read AGENTS.md first.",
      "lifecycle": "lazy-keep-alive",
      "requestTimeoutMs": 120000,
      "directTools": true
    }
  }
}
